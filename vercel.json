{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/app.py": {
      "maxDuration": 60
    },
    "api/aliexpress-oauth-callback.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=3600" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/integrations/aliexpress/callback",
      "destination": "/api/aliexpress-oauth-callback.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/app.py"
    }
  ],
  "crons": [
    {
      "path": "/internal/maintenance/release-expired-reservations",
      "schedule": "17 9 * * *"
    }
  ]
}
