{
  "version": 2,
  "builds": [
    {
      "src": "api/aliexpress-oauth-callback.js",
      "use": "@vercel/node"
    },
    {
      "src": "run.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "^/integrations/aliexpress/callback$",
      "dest": "/api/aliexpress-oauth-callback.js"
    },
    {
      "src": "/(.*)",
      "dest": "run.py"
    }
  ]
}